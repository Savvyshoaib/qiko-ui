VITE_APP_ID=dev-app
VITE_APP_VERSION=11.25.4

VITE_STRIPE_PUBLISHABLE_KEY=
VITE_LARAVEL_DECRYPT_KEY=

VITE_ENV=stage

# When true, all data comes from client/src/data/mock-data.json (no API calls).
# When false, the app uses the existing API client layer (network).
VITE_USE_MOCK_DATA=false

VITE_API_BASE_URL="https://stage-backend.qiko.ai/api/avatar"
VITE_ADMIN_API_BASE_URL="https://stage-admin-backend.qiko.ai"
VITE_CSP_CONNECT_SRC="https://stage-backend.qiko.ai https://el-backend.qiko.ai https://api.stripe.com https://api.vapi.ai wss://api.vapi.ai https://*.daily.co wss://*.daily.co https://ingest.sentry.io https://api.allorigins.win https://corsproxy.io https://api.calendly.com https://www.gstatic.com https://firebase.googleapis.com https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com https://*.googleapis.com"
VITE_LANDING_PAGE_URL=https://stage.qiko.ai

# Firebase Cloud Messaging (web) — keep client/public/firebase-messaging-sw.js in sync
# VITE_FIREBASE_VAPID_KEY = Firebase Console → Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=qiko-7ecf1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qiko-7ecf1
VITE_FIREBASE_STORAGE_BUCKET=qiko-7ecf1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=358481891207
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
