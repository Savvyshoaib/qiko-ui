<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header unset Content-Security-Policy
    Header always unset Content-Security-Policy

    Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://workers.qiko.ai https://el-backend.qiko.ai https://stage-backend.qiko.ai https://stage-admin-backend.qiko.ai https://api.stripe.com https://api.vapi.ai wss://api.vapi.ai https://*.daily.co wss://*.daily.co https://*.ingest.sentry.io https://cloudflareinsights.com https://*.cloudflareinsights.com https://api.allorigins.win https://corsproxy.io https://r.jina.ai https://api.calendly.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://js.stripe.com https://static.cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: https://*.stripe.com https://*.google.com; frame-src 'self' https://js.stripe.com;"
   
</IfModule>

RewriteEngine On
RewriteBase /

# Allow direct access to existing files/folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect all other requests to index.html
RewriteRule ^ index.html [L]

